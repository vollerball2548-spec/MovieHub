{
  "name": "moviehub-backend",
  "version": "1.0.0",
  "description": "Backend for MovieHub Cinema Booking App",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "data:migrate:mongodb": "node scripts/migrate-mongodb-to-postgres.js",
    "test": "node --test"
  },
  "keywords": [
    "express",
    "backend",
    "moviehub",
    "cinema",
    "api"
  ],
  "author": "MovieHub Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
