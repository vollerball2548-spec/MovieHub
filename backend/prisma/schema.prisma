generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  STAFF

  @@map("user_role")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  LEGACY_UNVERIFIED

  @@map("booking_status")
}

enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

enum TicketStatus {
  ACTIVE
  REDEEMED
  VOID

  @@map("ticket_status")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  legacyId        String?          @unique @map("legacy_id") @db.VarChar(24)
  username        String           @unique @db.VarChar(40)
  email           String           @unique @db.VarChar(254)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings        Booking[]
  sessions        RefreshSession[]
  auditEvents     AuditLog[]       @relation("AuditActor")
  redeemedTickets Ticket[]         @relation("TicketRedeemer")
  moviePurchases  MoviePurchase[]
  reviewedMoviePurchases MoviePurchase[] @relation("PurchaseReviewer")
  uploadedVideoAssets MovieVideoAsset[]  @relation("VideoUploader")
  reviewedVideoAssets MovieVideoAsset[] @relation("VideoReviewer")
  reviewedPaymentProofs PaymentProof[] @relation("PaymentProofReviewer")

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Movie {
  id              String     @id @default(uuid()) @db.Uuid
  legacyId        String?    @unique @map("legacy_id") @db.VarChar(24)
  title           String     @db.VarChar(200)
  genre           String?    @db.VarChar(80)
  releaseYear     Int?       @map("release_year") @db.SmallInt
  description     String?    @db.Text
  posterUrl       String?    @map("poster_url") @db.VarChar(2048)
  durationMinutes Int?       @map("duration_minutes") @db.SmallInt
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  showtimes       Showtime[]
  bookings        Booking[]
  purchases       MoviePurchase[]
  videoAsset      MovieVideoAsset?

  @@index([title])
  @@index([releaseYear])
  @@map("movies")
}

enum MoviePurchaseStatus {
  AWAITING_PAYMENT
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@map("movie_purchase_status")
}

enum MovieVideoStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED

  @@map("movie_video_status")
}

model MoviePurchase {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  movieId       String              @map("movie_id") @db.Uuid
  status        MoviePurchaseStatus @default(AWAITING_PAYMENT)
  amount        Decimal              @default(50) @db.Decimal(12, 2)
  currency      String               @default("THB") @db.Char(3)
  proofMimeType String?              @map("proof_mime_type") @db.VarChar(40)
  proofBytes    Bytes?               @map("proof_bytes")
  proofHash     String?              @map("proof_hash") @db.Char(64)
  reviewedBy    String?              @map("reviewed_by") @db.Uuid
  reviewNote    String?              @map("review_note") @db.VarChar(500)
  reviewedAt    DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  movie         Movie                @relation(fields: [movieId], references: [id], onDelete: Restrict)
  reviewer      User?                @relation("PurchaseReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([userId, movieId])
  @@index([status, createdAt])
  @@map("movie_purchases")
}

model MovieVideoAsset {
  id         String          @id @default(uuid()) @db.Uuid
  movieId    String          @unique @map("movie_id") @db.Uuid
  storageKey String          @unique @map("storage_key") @db.VarChar(255)
  mimeType   String          @map("mime_type") @db.VarChar(40)
  sizeBytes  BigInt          @map("size_bytes")
  sha256     String          @db.Char(64)
  rightsConfirmed Boolean    @default(false) @map("rights_confirmed")
  status     MovieVideoStatus @default(PENDING_REVIEW)
  uploadedBy String          @map("uploaded_by") @db.Uuid
  reviewedBy String?         @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  movie      Movie           @relation(fields: [movieId], references: [id], onDelete: Restrict)
  uploader   User            @relation("VideoUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewer   User?           @relation("VideoReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("movie_video_assets")
}

model Cinema {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(160)
  normalizedName String    @unique @map("normalized_name") @db.VarChar(160)
  address        String?   @db.VarChar(500)
  timezone       String    @default("Asia/Bangkok") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  screens        Screen[]
  bookings       Booking[]

  @@unique([name, address])
  @@map("cinemas")
}

model Screen {
  id        String     @id @default(uuid()) @db.Uuid
  cinemaId  String     @map("cinema_id") @db.Uuid
  name      String     @db.VarChar(80)
  format    String?    @db.VarChar(40)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, name])
  @@map("screens")
}

model Seat {
  id           String            @id @default(uuid()) @db.Uuid
  screenId     String            @map("screen_id") @db.Uuid
  rowLabel     String            @map("row_label") @db.VarChar(8)
  seatNumber   Int               @map("seat_number") @db.SmallInt
  seatType     String            @default("STANDARD") @map("seat_type") @db.VarChar(32)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]
  reservations SeatReservation[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

model Showtime {
  id           String            @id @default(uuid()) @db.Uuid
  movieId      String            @map("movie_id") @db.Uuid
  screenId     String            @map("screen_id") @db.Uuid
  startsAt     DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime          @map("ends_at") @db.Timestamptz(3)
  basePrice    Decimal           @map("base_price") @db.Decimal(12, 2)
  currency     String            @default("THB") @db.Char(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  movie        Movie             @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Restrict)
  bookings     Booking[]
  reservations SeatReservation[]

  @@unique([screenId, startsAt])
  @@index([movieId, startsAt])
  @@index([screenId, startsAt])
  @@map("showtimes")
}

model Booking {
  id                 String            @id @default(uuid()) @db.Uuid
  legacyId           String?           @unique @map("legacy_id") @db.VarChar(24)
  userId             String            @map("user_id") @db.Uuid
  movieId            String?           @map("movie_id") @db.Uuid
  cinemaId           String?           @map("cinema_id") @db.Uuid
  showtimeId         String?           @map("showtime_id") @db.Uuid
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(128)
  status             BookingStatus     @default(PENDING_PAYMENT)
  movieTitleSnapshot String            @map("movie_title_snapshot") @db.VarChar(200)
  cinemaNameSnapshot String?           @map("cinema_name_snapshot") @db.VarChar(160)
  legacyDateSnapshot String?           @map("legacy_date_snapshot") @db.VarChar(80)
  legacyTimeSnapshot String?           @map("legacy_time_snapshot") @db.VarChar(40)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  currency           String            @default("THB") @db.Char(3)
  expiresAt          DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  movie              Movie?            @relation(fields: [movieId], references: [id], onDelete: SetNull)
  cinema             Cinema?           @relation(fields: [cinemaId], references: [id], onDelete: SetNull)
  showtime           Showtime?         @relation(fields: [showtimeId], references: [id], onDelete: SetNull)
  seats              BookingSeat[]
  reservations       SeatReservation[]
  payments           Payment[]
  ticket             Ticket?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([showtimeId, status])
  @@map("bookings")
}

model BookingSeat {
  id                String   @id @default(uuid()) @db.Uuid
  bookingId         String   @map("booking_id") @db.Uuid
  seatId            String?  @map("seat_id") @db.Uuid
  seatLabelSnapshot String   @map("seat_label_snapshot") @db.VarChar(16)
  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 2)
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat              Seat?    @relation(fields: [seatId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([seatId])
  @@map("booking_seats")
}

model SeatReservation {
  id         String            @id @default(uuid()) @db.Uuid
  showtimeId String            @map("showtime_id") @db.Uuid
  seatId     String            @map("seat_id") @db.Uuid
  bookingId  String?           @map("booking_id") @db.Uuid
  status     ReservationStatus @default(HELD)
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  showtime   Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seat       Seat              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  booking    Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([showtimeId, status, expiresAt])
  @@index([bookingId])
  @@map("seat_reservations")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String        @db.VarChar(40)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(160)
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("THB") @db.Char(3)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  proof             PaymentProof?

  @@index([bookingId, status])
  @@map("payments")
}

model PaymentProof {
  id         String    @id @default(uuid()) @db.Uuid
  paymentId  String    @unique @map("payment_id") @db.Uuid
  mimeType   String    @map("mime_type") @db.VarChar(40)
  bytes      Bytes
  sha256     String    @unique @db.Char(64)
  note       String?   @db.VarChar(500)
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewer   User?     @relation("PaymentProofReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([reviewedBy])
  @@map("payment_proofs")
}

model PaymentEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(40)
  eventId     String    @map("event_id") @db.VarChar(160)
  eventType   String    @map("event_type") @db.VarChar(120)
  payloadHash String    @map("payload_hash") @db.Char(64)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("payment_events")
}

model Ticket {
  id         String       @id @default(uuid()) @db.Uuid
  bookingId  String       @unique @map("booking_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  status     TicketStatus @default(ACTIVE)
  issuedAt   DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)
  redeemedAt DateTime?    @map("redeemed_at") @db.Timestamptz(3)
  redeemedBy String?      @map("redeemed_by") @db.Uuid
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  redeemer   User?        @relation("TicketRedeemer", fields: [redeemedBy], references: [id], onDelete: SetNull)

  @@index([status, issuedAt])
  @@map("tickets")
}

model LegacyIdMap {
  id           String   @id @default(uuid()) @db.Uuid
  source       String   @db.VarChar(40)
  collection   String   @db.VarChar(80)
  legacyId     String   @map("legacy_id") @db.VarChar(64)
  targetEntity String   @map("target_entity") @db.VarChar(80)
  targetId     String   @map("target_id") @db.Uuid
  migratedAt   DateTime @default(now()) @map("migrated_at") @db.Timestamptz(3)

  @@unique([source, collection, legacyId])
  @@index([targetEntity, targetId])
  @@map("legacy_id_map")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
